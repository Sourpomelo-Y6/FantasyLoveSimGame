  entries:
  - trainingId: LightPractice
    visualState: 0
    messages:
    - "\u8EFD\u3044\u7A3D\u53E4\u304B\u3089\u59CB\u3081\u3088\u3046\u3002\u3042\u306A\u305F\u306E\u52D5\u304D\u3092\u3001\u3061\u3083\u3093\u3068\u898B\u3066\u3044\u308B\u306D\u3002"
    voicedMessages: []
  - trainingId: LightPractice
    visualState: 1
    messages:
    - "\u3046\u3093\u3001\u305D\u306E\u8ABF\u5B50\u3002\u7126\u3089\u306A\u3044\u52D5\u304D\u3001\u308F\u305F\u3057\u306F\u597D\u304D\u3060\u3088\u3002"
    voicedMessages: []
  - trainingId: LightPractice
    visualState: 2
    messages:
    - "\u7121\u7406\u3092\u3057\u305F\u306D\u3002\u5C11\u3057\u308F\u305F\u3057\u306B\u983C\u3063\u3066\u3002"
    voicedMessages: []
  - trainingId: LightPractice
    visualState: 3
    messages:
    - "\u308F\u305F\u3057\u306F\u5927\u4E08\u592B\u3002\u3042\u306A\u305F\u3068\u7D9A\u3051\u305F\u3044\u304B\u3089\u3001\u307E\u3060\u52D5\u3051\u308B\u3088\u3002"
    voicedMessages: []
  - trainingId: LightPractice
    visualState: 4
    messages:
    - "\u4E8C\u4EBA\u3068\u3082\u9650\u754C\u307F\u305F\u3044\u3002\u3067\u3082\u3001\u6700\u5F8C\u307E\u3067\u4E00\u7DD2\u3060\u3063\u305F\u306D\u3002"
    voicedMessages: []
  - trainingId: SparringPractice
    visualState: 0
    messages:
    - "\u5B9F\u6226\u5F62\u5F0F\u3060\u306D\u3002\u9060\u616E\u306F\u3057\u306A\u3044\u3051\u3069\u3001\u3042\u306A\u305F\u3092\u50B7\u3064\u3051\u305F\u304F\u306F\u306A\u3044\u306A\u3002"
    voicedMessages: []
  - trainingId: SparringPractice
    visualState: 1
    messages:
    - "\u4ECA\u306E\u653B\u9632\u3001\u3088\u304B\u3063\u305F\u3002\u3042\u306A\u305F\u306E\u6B21\u306E\u52D5\u304D\u3082\u77E5\u308A\u305F\u3044\u3002"
    voicedMessages: []
  - trainingId: SparringPractice
    visualState: 2
    messages:
    - "\u6355\u307E\u3048\u305F\u3002\u4ECA\u65E5\u306F\u3053\u3053\u307E\u3067\u306B\u3057\u3066\u3001\u3061\u3083\u3093\u3068\u4F11\u3082\u3046\u3002"
    voicedMessages: []
  - trainingId: SparringPractice
    visualState: 3
    messages:
    - "\u3042\u306A\u305F\u306E\u52DD\u3061\u3002\u6094\u3057\u3044\u3051\u3069\u3001\u5F37\u304F\u306A\u3063\u305F\u3042\u306A\u305F\u3092\u898B\u3089\u308C\u3066\u3046\u308C\u3057\u3044\u3002"
    voicedMessages: []
  - trainingId: SparringPractice
    visualState: 4
    messages:
    - "\u5F15\u304D\u5206\u3051\u3060\u306D\u3002\u6B21\u3082\u3001\u540C\u3058\u304F\u3089\u3044\u672C\u6C17\u3067\u5411\u304D\u5408\u3063\u3066\u3002"
    voicedMessages: []
  - trainingId: EnduranceTraining
    visualState: 0
    messages:
    - "\u9577\u3044\u8A13\u7DF4\u306B\u306A\u308B\u306D\u3002\u82E6\u3057\u304F\u306A\u3063\u305F\u3089\u3001\u308F\u305F\u3057\u306E\u58F0\u3092\u805E\u3044\u3066\u3002"
    voicedMessages: []
  - trainingId: EnduranceTraining
    visualState: 1
    messages:
    - "\u547C\u5438\u3092\u5408\u308F\u305B\u3088\u3046\u3002\u3042\u306A\u305F\u3068\u306A\u3089\u3001\u307E\u3060\u5148\u3078\u884C\u3051\u308B\u3002"
    voicedMessages: []
  - trainingId: EnduranceTraining
    visualState: 2
    messages:
    - "\u3082\u3046\u5341\u5206\u304C\u3093\u3070\u3063\u305F\u3088\u3002\u5012\u308C\u308B\u524D\u306B\u3001\u308F\u305F\u3057\u306E\u624B\u3092\u53D6\u3063\u3066\u3002"
    voicedMessages: []
  - trainingId: EnduranceTraining
    visualState: 3
    messages:
    - "\u5C11\u3057\u75B2\u308C\u305F\u3002\u3067\u3082\u3001\u3042\u306A\u305F\u304C\u305D\u3070\u306B\u3044\u308B\u304B\u3089\u6016\u304F\u306A\u3044\u3002"
    voicedMessages: []
  - trainingId: EnduranceTraining
    visualState: 4
    messages:
    - "\u3053\u3053\u307E\u3067\u3060\u306D\u3002\u4E8C\u4EBA\u3067\u652F\u3048\u5408\u3048\u305F\u3053\u3068\u3001\u5FD8\u308C\u305F\u304F\u306A\u3044\u306A\u3002"
    voicedMessages: []
  - trainingId: CooperativeDrill
    visualState: 0
    messages:
    - "\u9023\u643A\u6F14\u7FD2\u3001\u697D\u3057\u307F\u306B\u3057\u3066\u3044\u305F\u306E\u3002\u3042\u306A\u305F\u3068\u5FC3\u3092\u5408\u308F\u305B\u305F\u3044\u3002"
    voicedMessages: []
  - trainingId: CooperativeDrill
    visualState: 1
    messages:
    - "\u4ECA\u3001\u8003\u3048\u3066\u3044\u308B\u3053\u3068\u304C\u4F1D\u308F\u3063\u305F\u6C17\u304C\u3059\u308B\u3002\u3046\u308C\u3057\u3044\u306D\u3002"
    voicedMessages: []
  - trainingId: CooperativeDrill
    visualState: 2
    messages:
    - "\u4ECA\u5EA6\u306F\u308F\u305F\u3057\u304C\u652F\u3048\u308B\u756A\u3002\u4EFB\u305B\u3066\u3002"
    voicedMessages: []
  - trainingId: CooperativeDrill
    visualState: 3
    messages:
    - "\u652F\u3048\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3002\u3042\u306A\u305F\u306E\u624B\u3001\u5B89\u5FC3\u3059\u308B\u3002"
    voicedMessages: []
  - trainingId: CooperativeDrill
    visualState: 4
    messages:
    - "\u540C\u6642\u306B\u529B\u3092\u4F7F\u3044\u5207\u3063\u305F\u306D\u3002\u606F\u304C\u5408\u3063\u3066\u3044\u305F\u8A3C\u62E0\u304B\u306A\u3002"
