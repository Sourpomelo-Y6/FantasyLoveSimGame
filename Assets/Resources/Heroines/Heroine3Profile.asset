  initialDialogueMessage: "\u308F\u305F\u3057\u306F\u30AF\u30FC\u30C7\u30EA\u30A2\u3002\u3042\u306A\u305F\u3068\u4E00\u7DD2\u306B\u904E\u3054\u305B\u308B\u306A\u3089\u3001\u3046\u308C\u3057\u3044\u3002\u3053\u308C\u304B\u3089\u3088\u308D\u3057\u304F\u306D\u3002"
  initialDialogueVoiceId: 
  nextActionPrompt: "\u6B21\u306F\u4F55\u3092\u3059\u308B\uFF1F\u3000\u3042\u306A\u305F\u304C\u6C7A\u3081\u305F\u3053\u3068\u306A\u3089\u3001\u308F\u305F\u3057\u3082\u4E00\u7DD2\u306B\u884C\u304F\u3088\u3002"
  nextActionPromptVoiceId: 
  morningGreeting: "\u304A\u306F\u3088\u3046\u3002\u4ECA\u65E5\u3082\u3042\u306A\u305F\u306B\u4F1A\u3048\u3066\u3001\u3046\u308C\u3057\u3044\u3002"
  morningGreetingVoiceId: 
  goodNightGreeting: "\u304A\u3084\u3059\u307F\u3002\u660E\u65E5\u3082\u307E\u305F\u3001\u3042\u306A\u305F\u306E\u305D\u3070\u306B\u3044\u3089\u308C\u308B\u3068\u3044\u3044\u306A\u3002"
  goodNightGreetingVoiceId: 
  gameStartFallbackMessage: "\u3053\u3053\u304B\u3089\u3001\u308F\u305F\u3057\u305F\u3061\u306E\u6BCE\u65E5\u304C\u59CB\u307E\u308B\u3093\u3060\u306D\u3002"
  gameStartFollowUpMessage: "\u6025\u304C\u306A\u304F\u3066\u3044\u3044\u3088\u3002\u3042\u306A\u305F\u306E\u3053\u3068\u3092\u3001\u5C11\u3057\u305A\u3064\u6559\u3048\u3066\u3002"
  outfitMessageOverrides:
  - outfitId: Default
    lockedMessage: 
    changedMessage: "\u3053\u306E\u670D\u3001\u843D\u3061\u7740\u304F\u306E\u3002\u3042\u306A\u305F\u304C\u4F3C\u5408\u3046\u3068\u601D\u3063\u3066\u304F\u308C\u308B\u306A\u3089\u3001\u3046\u308C\u3057\u3044\u3002"
    changedExpressionId: 
  outfitReactionMessageOverrides:
  - reactionType: 0
    message: "\u4F3C\u5408\u3063\u3066\u3044\u308B\uFF1F\u3000\u3088\u304B\u3063\u305F\u3002\u3042\u306A\u305F\u306B\u305D\u3046\u8A00\u3063\u3066\u3082\u3089\u3048\u308B\u3068\u3001\u7D20\u76F4\u306B\u3046\u308C\u3057\u3044\u3002"
    expressionId: 
  - reactionType: 1
    message: "\u305D\u3046\u3002\u3042\u306A\u305F\u306E\u597D\u307F\u306B\u306F\u5408\u308F\u306A\u304B\u3063\u305F\u306E\u306D\u3002\u6B21\u306F\u3001\u3082\u3063\u3068\u4F3C\u5408\u3046\u3082\u306E\u3092\u4E00\u7DD2\u306B\u63A2\u3057\u3066\u3002"
    expressionId: 
  - reactionType: 2
    message: "\u3044\u3064\u3082\u540C\u3058\u3067\u306F\u3001\u3042\u306A\u305F\u3082\u98FD\u304D\u308B\uFF1F\u3000\u306A\u3089\u3001\u4ECA\u5EA6\u306F\u5C11\u3057\u9055\u3046\u670D\u3092\u8A66\u3057\u3066\u307F\u305F\u3044\u3002"
    expressionId: 
